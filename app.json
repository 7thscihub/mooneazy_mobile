{
  "expo": {
    "name": "mooneazy",
    "slug": "mooneazy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/rocket.png",
    "scheme": "mooneazy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.scihub.mooneazy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060612",
          "image": "./assets/icons/rocket.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/buzzer.wav"
          ]
        }
      ],
      "expo-font",
      "expo-background-task"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/rocket.png",
        "backgroundColor": "#060612"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.scihub.mooneazy",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/rocket.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4b21385-b2ab-4597-8b3c-13ab494be778"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d4b21385-b2ab-4597-8b3c-13ab494be778"
    }
  }
}
